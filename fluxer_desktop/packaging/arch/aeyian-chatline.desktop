[Desktop Entry]
Type=Application
Name=Aeyian Chatline
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec=/usr/bin/aeyian-chatline %U
Icon=aeyian-chatline
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=aeyian-chatline
StartupNotify=true
SingleMainWindow=true
MimeType=x-scheme-handler/chatline;
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=/usr/bin/aeyian-chatline --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=/usr/bin/aeyian-chatline --fluxer-task=new-dm %U
