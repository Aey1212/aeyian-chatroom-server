pkgname=aeyian-chatline
pkgver=1.0.0
pkgrel=1
pkgdesc='Aeyian Chatline desktop app'
arch=('x86_64')
url='https://chat.aeyempire.com'
license=('AGPL-3.0-or-later')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux-libs'
	'libsecret' 'libpulse' 'pipewire' 'gcc-libs' 'glibc')
options=('!strip' '!debug')
source=("Aeyian-Chatline-${pkgver}-linux-x64.tar.gz"
	'aeyian-chatline.desktop')
sha256sums=('SKIP'
	'SKIP')

package() {
	install -d "$pkgdir/opt/aeyian-chatline"
	cp -a "$srcdir/Aeyian-Chatline-${pkgver}-linux-x64/." "$pkgdir/opt/aeyian-chatline/"
	install -d "$pkgdir/usr/bin"
	ln -s /opt/aeyian-chatline/aeyian-chatline "$pkgdir/usr/bin/aeyian-chatline"
	install -Dm644 "$srcdir/aeyian-chatline.desktop" "$pkgdir/usr/share/applications/aeyian-chatline.desktop"
	for size in 16 24 32 48 64 128 256 512; do
		install -Dm644 "$pkgdir/opt/aeyian-chatline/resources/icons/${size}x${size}.png" \
			"$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/aeyian-chatline.png"
	done
}
